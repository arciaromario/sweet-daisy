# Supabase project credentials (Project Settings → API).
# Without them the site runs in demo mode using the local catalogue in src/data/.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL used for canonical links and social previews.
VITE_SITE_URL=https://www.sweetdaisycakes.com
